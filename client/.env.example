# Server-side backend URL used by the Next.js proxy and Server Components.
# Local: http://localhost:8000
# Dokploy Compose: http://api:8000 (set in Dokploy Environment UI)
API_BASE_URL=http://localhost:8000

# Optional fallback if API_BASE_URL is unset (avoid in production — exposed to browser bundle)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Shadcn Blocks Pro (https://shadcnblocks.com/dashboard/api) — required for @shadcnblocks/* installs
SHADCNBLOCKS_API_KEY=
