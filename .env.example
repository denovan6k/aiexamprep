# Copy to `.env` in the repo root before running docker compose.
# Never commit `.env` or reuse local values in production.
#
# Local compose (docker-compose.yml): Postgres, Redis, Adminer, worker.
# Production / Dokploy (docker-compose.prod.yml): postgres, redis, api, worker, client, docs.
# Dokploy: paste these into the Environment tab (writes .env next to the compose file).

APP_ENV=development

# Postgres (Compose service name `postgres` on the internal network)
POSTGRES_DB=knorvex
POSTGRES_USER=knorvex
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis
# Local host API: redis://localhost:6379/0
# docker-compose.prod.yml forces redis://redis:6379/0 for api/worker (ignores localhost REDIS_URL)
REDIS_URL=
REDIS_URL_DOCKER=redis://redis:6379/0
# Optional: queue material parse/chunk/embed on Arq (default false = inline in API)
QUEUE_MATERIAL_PROCESSING=false

API_CORS_ORIGINS=http://localhost:3000

# Auth
AUTH_SECRET=change-me

# AI — enable any combination of platform providers by setting keys.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_DEFAULT_MODEL=
GEMINI_DEFAULT_MODEL=
ANTHROPIC_DEFAULT_MODEL=
OPENROUTER_DEFAULT_MODEL=
DEFAULT_OPENROUTER_MODEL=
DEFAULT_PLATFORM_PROVIDER=
PLATFORM_PROVIDER_PRIORITY=gemini,openai,anthropic,openrouter
OPENROUTER_MODEL_FILTER=all
THREAD_TITLE_MODEL=
OPENROUTER_PROVIDER_IGNORE=
OPENROUTER_SERVICE_TIER=
OPENROUTER_CACHE_ENABLED=true

# Optional Headroom context compression (off by default)
HEADROOM_ENABLED=false
HEADROOM_COMPRESS_CHAT=true
HEADROOM_COMPRESS_GENERATION=true
HEADROOM_COMPRESS_MCP_TOOLS=true
HEADROOM_COMPRESS_ATTACHMENTS=false
HEADROOM_EXTRA=core

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_YEARLY_PRICE_ID=

SUPER_ADMIN_EMAILS=

# Email — see api/.env.example for full email configuration (Resend, SMTP, templates)
APP_PUBLIC_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Dokploy / docker-compose.prod.yml checklist (fill in the Dokploy UI)
# ---------------------------------------------------------------------------
# APP_ENV=production
# Migrations: api hardcodes RUN_MIGRATIONS=true in docker-compose.prod.yml (worker forces false).
#
# Internal DB/Redis (compose already rewrites DATABASE_URL to postgres DNS):
# POSTGRES_DB=knorvex
# POSTGRES_USER=knorvex
# POSTGRES_PASSWORD=<strong-secret>
# REDIS_URL=redis://redis:6379/0
#
# Public app / CORS (use your real HTTPS origins):
# API_CORS_ORIGINS=https://app.yourdomain.com
# APP_PUBLIC_URL=https://app.yourdomain.com
# AUTH_SECRET=<long-random-secret>
#
# Client (Next.js server-side proxy to the api service):
# API_BASE_URL=http://api:8000
# NEXT_PUBLIC_API_BASE_URL=   # optional; browser calls use /api/backend
#
# Media — production must use s3 or cloudinary (no VPS upload volume):
# MEDIA_STORAGE_PROVIDER=cloudinary
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
#   — or —
# MEDIA_STORAGE_PROVIDER=s3
# MEDIA_S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=auto
# S3_ENDPOINT_URL=            # required for R2 / B2-compatible endpoints
#
# Domains in Dokploy: app → client:3000, api → api:8000, docs → docs:3000
# Docs site URL in repo config: https://docs.knorvex.com
