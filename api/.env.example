APP_ENV=development

# Primary: set DATABASE_URL directly (takes precedence over POSTGRES_* below).
# Railway: use reference variable ${{Postgres.DATABASE_URL}} — postgresql:// is auto-normalized to psycopg.
DATABASE_URL=postgresql+psycopg://knorvex:your-password@localhost:5432/knorvex

# Optional fallback — only used when DATABASE_URL is empty.
POSTGRES_DB=knorvex
POSTGRES_USER=knorvex
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Railway: use reference variable ${{Redis.REDIS_URL}}
REDIS_URL=redis://localhost:6379/0
ENABLE_JOB_QUEUE=true
# Optional: queue material parse/chunk/embed on Arq workers (requires a running worker + shared uploads).
# Default false — materials process inline so /search works without docker compose worker.
QUEUE_MATERIAL_PROCESSING=false
MAX_CONCURRENT_GLOBAL_JOBS=4
MAX_PENDING_GENERATION_JOBS_PER_USER=8
API_CORS_ORIGINS=http://localhost:3000

AUTH_SECRET=change-me

# Platform LLM providers (enable any combination by setting the key).
# Official base URLs are built into the app; only keys and default model ids are env.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Per-provider default model ids (empty = first model from that provider's live catalog).
OPENAI_DEFAULT_MODEL=
GEMINI_DEFAULT_MODEL=
ANTHROPIC_DEFAULT_MODEL=
OPENROUTER_DEFAULT_MODEL=
# Compat alias for OPENROUTER_DEFAULT_MODEL when the latter is empty
DEFAULT_OPENROUTER_MODEL=

# When multiple keys are set: preferred provider, then ordered fallback walk.
DEFAULT_PLATFORM_PROVIDER=
PLATFORM_PROVIDER_PRIORITY=gemini,openai,anthropic,openrouter

# OpenRouter model listing: all | free | paid
OPENROUTER_MODEL_FILTER=all

# Optional cheap model for auto-refining chat thread titles after the first reply
THREAD_TITLE_MODEL=

# Optional OpenRouter latency tuning (comma-separated provider slugs to skip)
OPENROUTER_PROVIDER_IGNORE=
# Use "priority" for faster routing when supported (leave empty for default)
OPENROUTER_SERVICE_TIER=
# Cache identical OpenRouter requests (true/false)
OPENROUTER_CACHE_ENABLED=true

# Optional Headroom context compression (off by default; fail-open)
HEADROOM_ENABLED=false
HEADROOM_COMPRESS_CHAT=true
HEADROOM_COMPRESS_GENERATION=true
HEADROOM_COMPRESS_MCP_TOOLS=true
HEADROOM_COMPRESS_ATTACHMENTS=false
# Install hint: core | ml
HEADROOM_EXTRA=core

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_YEARLY_PRICE_ID=

RATE_LIMIT_ENABLED=true
RATE_LIMIT_QUIZ_GENERATIONS_PER_HOUR=20
RATE_LIMIT_CHAT_GENERATIONS_PER_HOUR=60
RATE_LIMIT_CONTACT_PER_HOUR=5

# Comma-separated emails that receive super admin privileges (blog admin, platform moderation)
SUPER_ADMIN_EMAILS=

# File storage — use "local" for dev, "s3" for production object storage when applicable
STORAGE_BACKEND=local
UPLOAD_DIR=uploads
PUBLIC_UPLOAD_BASE_URL=/uploads

# Chat / study media — production: cloudinary or s3 (not local / not VPS disk)
MEDIA_STORAGE_PROVIDER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
MEDIA_S3_BUCKET=

# S3-compatible storage (MEDIA_STORAGE_PROVIDER=s3 and/or STORAGE_BACKEND=s3)
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_PRIVATE_BUCKET=
S3_PUBLIC_BUCKET=
S3_PUBLIC_BASE_URL=

# Email transport: resend | smtp | console
# Use resend locally to test real delivery — APP_ENV does not need to be production.
EMAIL_PROVIDER=console

# Shared sender (all providers)
EMAIL_FROM=Knorvex <noreply@support.knorvex.com>
EMAIL_REPLY_TO=support@support.knorvex.com
CONTACT_INBOX=support@support.knorvex.com

# App URL for logo/links in email templates
APP_PUBLIC_URL=http://localhost:3000

# Resend (when EMAIL_PROVIDER=resend)
RESEND_API_KEY=

# SMTP (when EMAIL_PROVIDER=smtp)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# Optional: send security alert on successful login
EMAIL_LOGIN_ALERTS_ENABLED=true
